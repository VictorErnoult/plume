# Réglages de publication de Plume, lus par scripts/release.sh et scripts/publish.sh.
# Rien de secret ici : le certificat, le mot de passe de notarisation et la clé privée des
# mises à jour restent dans le trousseau du Mac.

# Certificat « Developer ID Application » (compte Apple Developer). Tant qu'il est vide,
# release.sh tourne en mode essai : signature locale, pas de notarisation.
PLUME_IDENTITY=""

# Profil de notarisation enregistré une fois avec :
#   xcrun notarytool store-credentials plume-notary --apple-id … --team-id … --password …
PLUME_NOTARY_PROFILE="plume-notary"

# Dépôt GitHub public dont les « releases » hébergent l'image disque et le flux de mises à jour.
PLUME_REPO="soyAkil/plume"

# Clé publique des mises à jour (EdDSA), inscrite dans l'app. La clé privée est dans le
# trousseau : « Private key for signing Sparkle updates ».
PLUME_ED_PUBLIC_KEY="YyOkQ0OC5cLSGf5jYYlKcQijbm+62HLunqAl3PdM3nQ="
